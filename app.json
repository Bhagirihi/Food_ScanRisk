{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5E1224",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.bytesphere.scanrisk",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.bytesphere.scanrisk",
      "supportsTablet": true
    },
    "name": "ScanRisk",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ScanRisk to use your camera to scan product barcodes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ScanRisk uses your location only to set your country — allergens, units and prices for where you live. Your precise location is never stored."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4A121A",
          "icon": "./assets/icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A121A",
          "image": "./assets/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4173581536398147~9075949121",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "scheme": "scanrisk",
    "slug": "scanrisk",
    "userInterfaceStyle": "light",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7de103bc-07ae-475d-ad69-cedca2053ba2"
      }
    },
    "owner": "takeyshi"
  }
}
